{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://held-in-ink.local/content.schema.json",
  "title": "Held in Ink content",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentVersion", "prompts"],
  "properties": {
    "$schema": { "$ref": "#/$defs/nonBlank" },
    "contentVersion": { "const": 3 },
    "prompts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/prompt" }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "httpUrl": {
      "allOf": [
        { "$ref": "#/$defs/nonBlank" },
        { "format": "uri", "pattern": "^https?://" }
      ]
    },
    "mediaSrc": {
      "allOf": [
        { "$ref": "#/$defs/nonBlank" },
        { "pattern": "^(assets/|https?://)" }
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scene", "layers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "scene": { "$ref": "#/$defs/scene" },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stroke", "narrative", "context"],
          "properties": {
            "stroke": { "$ref": "#/$defs/stroke" },
            "narrative": { "$ref": "#/$defs/narrative" },
            "context": { "$ref": "#/$defs/context" }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kicker", "homeTitle", "homeDeck", "theme", "sequence", "evidenceLabel", "defaultSurface"],
      "properties": {
        "kicker": { "$ref": "#/$defs/nonBlank" },
        "homeTitle": { "$ref": "#/$defs/nonBlank" },
        "homeDeck": { "$ref": "#/$defs/nonBlank" },
        "theme": { "enum": ["message", "crossing", "witness", "invocation"] },
        "sequence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "evidenceLabel": { "$ref": "#/$defs/nonBlank" },
        "defaultSurface": { "enum": ["paper", "fan", "cloth"] }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "symbol", "phrase", "transcription", "phraseReading", "gloss", "guideLabel", "reference", "referenceNote"],
      "properties": {
        "status": { "enum": ["verified-digital-reconstruction", "dictionary-derived-reconstruction", "pending-verification"] },
        "symbol": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonBlank" }
          ]
        },
        "phrase": {
          "oneOf": [
            { "type": "null" },
            {
              "allOf": [
                { "$ref": "#/$defs/nonBlank" },
                { "minLength": 2 }
              ]
            }
          ]
        },
        "transcription": { "$ref": "#/$defs/nonBlank" },
        "phraseReading": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonBlank" }
          ]
        },
        "gloss": { "$ref": "#/$defs/nonBlank" },
        "guideLabel": { "$ref": "#/$defs/nonBlank" },
        "reference": { "$ref": "#/$defs/nonBlank" },
        "referenceNote": { "$ref": "#/$defs/nonBlank" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["verified-digital-reconstruction", "dictionary-derived-reconstruction"] } } },
          "then": {
            "properties": {
              "symbol": { "$ref": "#/$defs/nonBlank" },
              "phrase": {
                "allOf": [
                  { "$ref": "#/$defs/nonBlank" },
                  { "minLength": 2 }
                ]
              },
              "phraseReading": { "$ref": "#/$defs/nonBlank" }
            }
          },
          "else": {
            "properties": {
              "symbol": { "const": null },
              "phrase": { "const": null },
              "phraseReading": { "const": null }
            }
          }
        }
      ]
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sender", "receiver", "time", "title", "place", "storyType", "story", "writingLines", "after", "archiveNote"],
      "properties": {
        "sender": { "$ref": "#/$defs/nonBlank" },
        "receiver": { "$ref": "#/$defs/nonBlank" },
        "time": { "$ref": "#/$defs/nonBlank" },
        "title": { "$ref": "#/$defs/nonBlank" },
        "place": { "$ref": "#/$defs/nonBlank" },
        "storyType": { "$ref": "#/$defs/nonBlank" },
        "story": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "writingLines": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "after": { "$ref": "#/$defs/nonBlank" },
        "archiveNote": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "sources", "artefact", "audio"],
      "properties": {
        "note": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonBlank" }
          ]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "artefact": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/artefact" }
          ]
        },
        "audio": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/audio" }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "credit", "url"],
      "properties": {
        "label": { "$ref": "#/$defs/nonBlank" },
        "credit": { "$ref": "#/$defs/nonBlank" },
        "url": { "$ref": "#/$defs/httpUrl" },
        "rights": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "artefact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "src", "alt", "caption", "credit", "sourceUrl", "rights"],
      "properties": {
        "kind": { "enum": ["photograph", "artefact"] },
        "src": { "$ref": "#/$defs/mediaSrc" },
        "alt": { "$ref": "#/$defs/nonBlank" },
        "caption": { "$ref": "#/$defs/nonBlank" },
        "credit": { "$ref": "#/$defs/nonBlank" },
        "sourceUrl": { "$ref": "#/$defs/httpUrl" },
        "rights": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "mimeType", "title", "description", "transcript", "credit", "sourceUrl", "rights"],
      "properties": {
        "src": { "$ref": "#/$defs/mediaSrc" },
        "mimeType": { "type": "string", "pattern": "^audio/\\S+$" },
        "title": { "$ref": "#/$defs/nonBlank" },
        "description": { "$ref": "#/$defs/nonBlank" },
        "transcript": { "$ref": "#/$defs/nonBlank" },
        "credit": { "$ref": "#/$defs/nonBlank" },
        "sourceUrl": { "$ref": "#/$defs/httpUrl" },
        "rights": { "$ref": "#/$defs/nonBlank" }
      }
    }
  }
}
